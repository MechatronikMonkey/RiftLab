# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Virtuelle Umgebungen
.venv/
venv/

# Ein-/Ausgaben lokaler Auswertungen
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.png
# ...aber die versionierten Event-Icons behalten
!riftlab/assets/**/*.png

# Build output (packaging/build.ps1). The frozen folder and the installer are
# release artefacts - they come from a tag, never from the repository.
dist/
build/
.venv-build/
# The icon is generated from the viewer's palette on every build (make_icon.py),
# so the repository stays free of binary assets.
packaging/*.ico
